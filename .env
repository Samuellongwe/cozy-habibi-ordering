# Production environment file - KEEP SECRETS SAFE
# Never commit real secrets; use GitHub Secrets or your deployment platform's secret manager

PORT=3000
NODE_ENV=development
DB_PATH=./data/cozy.db
LOG_LEVEL=debug

# JWT Secret: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be 32+ characters
JWT_SECRET=5e98894371769b5cdd35bd83c59861cc0279f68500d79ff0134d3be799ade9e63f2e7ea3d3bf261810b274b174dbae44

# CORS: Explicitly set in production (e.g., https://cozy-restaurant.com)
# Leave as true for development (allows all origins)
CORS_ORIGIN=true

# Production deployment: 
# NODE_ENV=production
# CORS_ORIGIN=https://your-production-domain.com
# LOG_LEVEL=info
